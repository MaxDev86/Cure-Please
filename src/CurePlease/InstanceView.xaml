<UserControl x:Class="CurePlease.InstanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CurePlease">
    <UserControl.Resources>
        <local:PercentBarBrushConverter x:Key="BarBrush"/>

        <!-- Flat progress bar: rounded fill on a light track, no chrome/animation -->
        <Style x:Key="FlatBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Background" Value="#FFF0F0F0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="140"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180" MinHeight="70"/>
        </Grid.RowDefinitions>

        <!-- Independent attachments on the left; the tall action button stays on the right. -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="PL:" VerticalAlignment="Center"/>
            <ComboBox x:Name="PlPidBox" Grid.Row="0" Grid.Column="1" Margin="6,0,12,0"
                      IsSynchronizedWithCurrentItem="False" DropDownOpened="PidCombo_DropDownOpened"
                      ToolTip="The character Cure-Please controls. All spells, abilities, items, and follow commands come from this client."/>
            <Button x:Name="AttachButton" Grid.Row="0" Grid.Column="2" Content="Attach" Width="80"
                    Click="AttachButton_Click"
                    ToolTip="Attach or detach the PL. Detaching stops the engine and disconnects the monitored character too."/>
            <TextBlock x:Name="StatusText" Grid.Row="0" Grid.Column="3" Text="Detached"
                       VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Monitored:" VerticalAlignment="Center" Margin="0,4,0,0"/>
            <ComboBox x:Name="MonitoredPidBox" Grid.Row="1" Grid.Column="1" Margin="6,4,12,0"
                      IsSynchronizedWithCurrentItem="False" DropDownOpened="PidCombo_DropDownOpened"
                      SelectionChanged="MonitoredPidBox_SelectionChanged"
                      ToolTip="The character Cure-Please watches for party and character information. This client is not controlled."/>
            <Button x:Name="MonitoredAttachButton" Grid.Row="1" Grid.Column="2" Content="Attach" Width="80"
                    Margin="0,4,0,0" Click="MonitoredAttachButton_Click" IsEnabled="False"
                    ToolTip="Attach, switch, or detach the monitored character. Switching or detaching stops the engine until both characters are attached."/>
            <TextBlock x:Name="MonitoredStatusText" Grid.Row="1" Grid.Column="3" Text="Detached"
                       VerticalAlignment="Center" Margin="12,4,0,0" Foreground="Gray"/>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="ImportButton" Content="Import legacy…" Width="100" Margin="0,0,8,0" Click="ImportButton_Click"
                        ToolTip="Import a legacy XML file and save it immediately to the active profile, creating the default profile if needed."/>
                <Button Content="Settings…" Width="80" Margin="0,0,8,0" Click="SettingsButton_Click"/>
            </StackPanel>
            <Button x:Name="StartButton" Grid.Row="0" Grid.RowSpan="3" Grid.Column="5"
                    Content="Start" MinHeight="72" Margin="16,0,0,0" FontSize="16" FontWeight="SemiBold"
                    Click="StartButton_Click" IsEnabled="False"/>
        </Grid>

        <!-- Active profile + auto-switch preference (global, not per-profile) -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,4">
            <TextBlock Text="Profile:" VerticalAlignment="Center" Foreground="Gray"/>
            <ComboBox x:Name="ActiveProfileBox" Width="200" Margin="4,0,12,0"
                      IsEditable="True" IsReadOnly="True" IsSynchronizedWithCurrentItem="False"
                      DropDownOpened="ActiveProfileBox_DropDownOpened"
                      SelectionChanged="ActiveProfileBox_SelectionChanged"
                      ToolTip="Pick a profile manually. It sticks until a job/character change (or forever when auto-switch is off)."/>
            <CheckBox x:Name="AutoSwitchBox" Content="Auto-switch on job/character change"
                      VerticalAlignment="Center" Checked="AutoSwitchBox_Toggled" Unchecked="AutoSwitchBox_Toggled"
                      ToolTip="Off = the manually picked profile stays active across job/character changes (a notice is logged instead)."/>
        </StackPanel>

        <!-- Player state: compact job line only — full status lives in Character Info -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,6">
            <TextBlock x:Name="JobStatsText" Text="" FontFamily="Consolas" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button x:Name="JobInfoButton" Content="Character Info…" Padding="6,0" Margin="8,0,0,0"
                    VerticalAlignment="Center" Click="JobInfoButton_Click" Visibility="Collapsed"
                    ToolTip="Live status, all jobs, spells, and abilities"/>
        </StackPanel>

        <!-- Party/alliance list: slots 0-5 own party, 6-11 / 12-17 alliance parties -->
        <DataGrid x:Name="PartyGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" Margin="0,0,0,6" CanUserAddRows="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pt" Binding="{Binding PartyDisplay}" Width="30"/>
                <DataGridTextColumn Header="#" Binding="{Binding MemberNumber}" Width="30"/>
                <DataGridTemplateColumn Header="On" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ToolTip="Enable cures, buffs, debuff removal, and other supported actions for this character"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                <DataGridTemplateColumn Header="HP" Width="135">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <ProgressBar Style="{StaticResource FlatBar}" Value="{Binding HPP, Mode=OneWay}"
                                             Foreground="{Binding HPP, Converter={StaticResource BarBrush}}"/>
                                <TextBlock Text="{Binding HpText}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="10" Foreground="#FF202020"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="MP" Width="135">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <ProgressBar Style="{StaticResource FlatBar}" Value="{Binding MPP, Mode=OneWay}"
                                             Foreground="{Binding MPP, Converter={StaticResource BarBrush}, ConverterParameter=mp}"/>
                                <TextBlock Text="{Binding MpText}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="10" Foreground="#FF202020"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="TP" Binding="{Binding CurrentTP}" Width="60"/>
                <DataGridTextColumn Header="Job" Binding="{Binding JobDisplay}" Width="90"/>
                <DataGridTextColumn Header="Buffs" Binding="{Binding BuffSummary}" Width="*"/>
                <DataGridTemplateColumn Header="" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Buffs…" Padding="6,0" Click="PlayerBuffsButton_Click"
                                    ToolTip="{Binding BuffButtonTooltip}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding FollowLabel}" Padding="6,0" Click="FollowButton_Click"
                                    IsEnabled="{Binding CanFollow}" ToolTip="{Binding FollowTooltip}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                      Background="#FFE0E0E0" Cursor="SizeNS"
                      ToolTip="Drag to resize the character grid and log"/>

        <!-- Engine log -->
        <TextBox x:Name="LogBox" Grid.Row="5" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"/>
    </Grid>
</UserControl>

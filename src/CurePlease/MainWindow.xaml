<Window x:Class="CurePlease.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cure Please" Height="560" Width="820">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Attach bar -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="PL:" VerticalAlignment="Center"/>
            <ComboBox x:Name="PlPidBox" Width="160" Margin="4,0,12,0"
                      IsSynchronizedWithCurrentItem="False" DropDownOpened="PidCombo_DropDownOpened"/>
            <TextBlock Text="Monitored:" VerticalAlignment="Center"/>
            <ComboBox x:Name="MonitoredPidBox" Width="160" Margin="4,0,12,0"
                      IsSynchronizedWithCurrentItem="False" DropDownOpened="PidCombo_DropDownOpened"/>
            <Button x:Name="AttachButton" Content="Attach" Width="80" Margin="0,0,8,0" Click="AttachButton_Click"/>
            <Button x:Name="StartButton" Content="Start" Width="80" Margin="0,0,8,0" Click="StartButton_Click" IsEnabled="False"/>
            <Button x:Name="ImportButton" Content="Import legacy…" Width="100" Margin="0,0,8,0" Click="ImportButton_Click"/>
            <TextBlock x:Name="StatusText" Text="Detached" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold"/>
        </StackPanel>

        <!-- Player state -->
        <TextBlock x:Name="PlayerText" Grid.Row="1" Text="—" Margin="0,0,0,6" FontFamily="Consolas"/>

        <!-- Party list -->
        <DataGrid x:Name="PartyGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" Margin="0,0,0,6" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding MemberNumber}" Width="30"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="HP" Binding="{Binding CurrentHP}" Width="70"/>
                <DataGridTextColumn Header="HPP" Binding="{Binding CurrentHPP}" Width="50"/>
                <DataGridTextColumn Header="MP" Binding="{Binding CurrentMP}" Width="70"/>
                <DataGridTextColumn Header="TP" Binding="{Binding CurrentTP}" Width="60"/>
                <DataGridTextColumn Header="Job" Binding="{Binding JobDisplay}" Width="80"/>
                <DataGridTextColumn Header="Active" Binding="{Binding Active}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Engine log -->
        <TextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"/>
    </Grid>
</Window>

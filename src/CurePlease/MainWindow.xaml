<Window x:Class="CurePlease.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CurePlease3" Height="700" Width="1060">
    <!-- One tab per attached game instance. The trailing "+" tab opens a new
         instance; tabs after the first carry their own close button. -->
    <TabControl x:Name="InstanceTabs" Margin="4" SelectionChanged="InstanceTabs_SelectionChanged"/>
</Window>

<Window x:Class="CurePlease.PlayerJobsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Character Info" Height="640" Width="560">
    <TabControl Margin="8">
        <TabItem Header="Jobs">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="JobsGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job" Binding="{Binding Job}" Width="70"/>
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="50"/>
                        <DataGridTextColumn Header="Mastered" Binding="{Binding Mastered}" Width="70"/>
                        <DataGridTextColumn Header="ML" Binding="{Binding MasterLevel}" Width="50"/>
                        <DataGridTextColumn Header="Job Points" Binding="{Binding JobPoints}" Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentJob}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Refresh" Width="80" Click="RefreshButton_Click"/>
                    <TextBlock Text="Current main/sub job in bold. Mastery = 2100 spent job points."
                               VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Spells">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Job:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SpellJobBox" Width="100" Margin="4,0,12,0" SelectionChanged="SpellFilter_Changed"/>
                    <CheckBox x:Name="LearnableOnlyBox" Content="Learnable only" VerticalAlignment="Center"
                              Checked="SpellFilter_Changed" Unchecked="SpellFilter_Changed"
                              ToolTip="Show only spells your level qualifies for but you have not learned"/>
                    <CheckBox x:Name="ShowLockedBox" Content="Show locked" VerticalAlignment="Center" Margin="10,0,0,0"
                              IsChecked="True" Checked="SpellFilter_Changed" Unchecked="SpellFilter_Changed"
                              ToolTip="Include spells above your job level"/>
                    <Button Content="Refresh" Width="70" Margin="14,0,0,0" Click="SpellRefresh_Click"
                            ToolTip="Re-read the spell list and known-spell mask (use after learning new spells)"/>
                </StackPanel>

                <DataGrid x:Name="SpellsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="Bold" Text="{Binding Name}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel Margin="0,6,0,0">
                                                    <ContentPresenter/>
                                                    <ItemsPresenter/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Spell" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="60"/>
                        <DataGridTemplateColumn Header="Status" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" ToolTip="{Binding StatusTooltip}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Learned">
                                                        <Setter Property="Foreground" Value="Green"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Locked">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="GearGated">
                                                        <Setter Property="Foreground" Value="RoyalBlue"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Type" Binding="{Binding MagicType}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Abilities">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Job:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="AbilityJobBox" Width="100" Margin="4,0,12,0" SelectionChanged="AbilityFilter_Changed"/>
                    <CheckBox x:Name="AbilityLearnableOnlyBox" Content="Learnable only" VerticalAlignment="Center"
                              Checked="AbilityFilter_Changed" Unchecked="AbilityFilter_Changed"
                              ToolTip="Show only abilities your level qualifies for but you have not learned"/>
                    <CheckBox x:Name="AbilityShowLockedBox" Content="Show locked" VerticalAlignment="Center" Margin="10,0,0,0"
                              IsChecked="True" Checked="AbilityFilter_Changed" Unchecked="AbilityFilter_Changed"
                              ToolTip="Include abilities above your job level"/>
                </StackPanel>

                <DataGrid x:Name="AbilitiesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="Bold" Text="{Binding Name}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel Margin="0,6,0,0">
                                                    <ContentPresenter/>
                                                    <ItemsPresenter/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ability" Binding="{Binding Name}" Width="170"/>
                        <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="45"/>
                        <DataGridTemplateColumn Header="Status" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" ToolTip="{Binding StatusTooltip}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Learned">
                                                        <Setter Property="Foreground" Value="Green"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Locked">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="MeritGated">
                                                        <Setter Property="Foreground" Value="DarkOrange"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap"
                           Text="Pet commands, blood pacts, and wyvern breaths are not listed — they are pet/avatar-gated, not job-learned. COR rolls show as Learned only after using the matching die."/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>

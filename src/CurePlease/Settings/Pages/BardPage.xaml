<UserControl x:Class="CurePlease.Settings.Pages.BardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CurePlease.Settings.Pages"
             xmlns:core="clr-namespace:CurePlease.Core.Modules">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <CheckBox Content="Enable Bard support (main or sub job BRD)"
                      IsChecked="{Binding Settings.Enabled, UpdateSourceTrigger=PropertyChanged}"
                      FontWeight="Bold"/>

            <!-- Party rotation -->
            <TextBlock Text="Party song rotation" FontWeight="Bold" Margin="0,14,0,4"/>
            <TextBlock Text="Sung in order on yourself (AoE). With more instrument slots than songs, the dummy songs below pad the spare slots."
                       TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="PartySongsList" ItemsSource="{Binding PartySongs}" Height="110"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <ComboBox x:Name="PartySongPicker" Width="180" IsEditable="True"
                              ItemsSource="{Binding Source={x:Static local:BardEditModel.KnownSongs}}"/>
                    <Button Content="Add" Click="AddPartySong_Click" Margin="0,4,0,0"/>
                    <Button Content="Remove" Click="RemovePartySong_Click" Margin="0,4,0,0"/>
                    <Button Content="Move up" Click="MovePartySongUp_Click" Margin="0,8,0,0"/>
                    <Button Content="Move down" Click="MovePartySongDown_Click" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Dummy songs -->
            <TextBlock Text="Dummy songs" FontWeight="Bold" Margin="0,14,0,4"/>
            <TextBlock Text="Placeholder songs for instrument-granted slots. Your GearSwap lua must sing these WITHOUT the duration midcast set (equipping the multi-song instrument) — that is what guarantees real songs overwrite them."
                       TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="DummySongsList" ItemsSource="{Binding DummySongs}" Height="70"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <ComboBox x:Name="DummySongPicker" Width="180" IsEditable="True"
                              ItemsSource="{Binding Source={x:Static local:BardEditModel.KnownSongs}}"/>
                    <Button Content="Add" Click="AddDummySong_Click" Margin="0,4,0,0"/>
                    <Button Content="Remove" Click="RemoveDummySong_Click" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Dummy placement on rebuild:" VerticalAlignment="Center" Width="170"/>
                <ComboBox SelectedItem="{Binding Settings.DummyPlacement, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Source={x:Static local:BardEditModel.DummyPlacements}}" Width="100"/>
                <TextBlock Text="Middle = after the first two real songs; First = before everything."
                           VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
            </StackPanel>

            <!-- Instruments -->
            <TextBlock Text="Owned instruments" FontWeight="Bold" Margin="0,14,0,4"/>
            <TextBlock Text="Declares what your GearSwap lua has to work with: sets the song-slot count and gates Honor March (Marsyas) / Aria of Passion (Loughnashade). Empty = auto-detect from the equipped instrument. Cure-Please never equips anything itself."
                       TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="InstrumentsList" ItemsSource="{Binding OwnedInstruments}" Height="70"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <ComboBox x:Name="InstrumentPicker" Width="180" IsEditable="True"
                              ItemsSource="{Binding Source={x:Static core:BardModule.KnownInstrumentNames}}"/>
                    <Button Content="Add" Click="AddInstrument_Click" Margin="0,4,0,0"/>
                    <Button Content="Remove" Click="RemoveInstrument_Click" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Job abilities -->
            <TextBlock Text="Job abilities" FontWeight="Bold" Margin="0,14,0,4"/>
            <CheckBox Content="Nightingale + Troubadour before a refresh pass (NiTro)"
                      IsChecked="{Binding Settings.UseNitro, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
            <CheckBox Content="Soul Voice (1h) before a refresh pass, and upgrade re-sing while it is up"
                      IsChecked="{Binding Settings.UseSoulVoice, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <CheckBox Content="Marcato paired with:"
                          IsChecked="{Binding Settings.UseMarcato, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <ComboBox SelectedItem="{Binding Settings.MarcatoSong, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Source={x:Static local:BardEditModel.KnownSongs}}" IsEditable="True"
                          Width="180" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <CheckBox Content="Clarion Call for the slot overflow, song:"
                          IsChecked="{Binding Settings.UseClarionCall, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <ComboBox SelectedItem="{Binding Settings.ClarionSong, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Source={x:Static local:BardEditModel.KnownSongs}}" IsEditable="True"
                          Width="180" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Pianissimo -->
            <TextBlock Text="Pianissimo targets" FontWeight="Bold" Margin="0,14,0,4"/>
            <TextBlock Text="Single-target top-ups on named party members (needs buff visibility: monitored character or the addon)."
                       TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"/>
            <DataGrid ItemsSource="{Binding PianissimoTargets}" AutoGenerateColumns="False"
                      CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column" Height="90">
                <DataGrid.Columns>
                    <DataGridComboBoxColumn Header="Song" Width="*"
                        SelectedItemBinding="{Binding Song, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{x:Static local:BardEditModel.KnownSongs}"/>
                    <DataGridTextColumn Header="Target" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Enemy songs -->
            <TextBlock Text="Enemy debuff songs" FontWeight="Bold" Margin="0,14,0,4"/>
            <TextBlock Text="Kept on your battle target while engaged (Elegy, Nocturne, Threnody, Requiem, Lullaby). Tracked on a conservative timer — enemy debuffs are not readable."
                       TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="EnemySongsList" ItemsSource="{Binding EnemyDebuffSongs}" Height="60"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <ComboBox x:Name="EnemySongPicker" Width="180" IsEditable="True"
                              ItemsSource="{Binding Source={x:Static local:BardEditModel.KnownEnemySongs}}"/>
                    <Button Content="Add" Click="AddEnemySong_Click" Margin="0,4,0,0"/>
                    <Button Content="Remove" Click="RemoveEnemySong_Click" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Timing -->
            <TextBlock Text="Timing" FontWeight="Bold" Margin="0,14,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Song duration (s):" VerticalAlignment="Center" Width="170"/>
                <TextBox Text="{Binding Settings.BaseDurationSeconds, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <TextBlock Text="Estimate before Troubadour/Soul Voice doubling; used only to refresh early."
                           VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Refresh margin (s):" VerticalAlignment="Center" Width="170"/>
                <TextBox Text="{Binding Settings.RefreshMarginSeconds, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <TextBlock Text="Re-sing when estimated remaining time drops below this."
                           VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Song range (yalms):" VerticalAlignment="Center" Width="170"/>
                <TextBox Text="{Binding Settings.SongRangeYalms, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <TextBlock Text="Members beyond this are not waited on (9.9 with Horn)."
                           VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>

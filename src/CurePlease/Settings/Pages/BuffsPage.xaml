<UserControl x:Class="CurePlease.Settings.Pages.BuffsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Buff upkeep (PL only)" FontWeight="Bold" FontSize="14"/>
        <TextBlock Grid.Row="1" Text="Buffs kept on the character running Cure Please. One row per buff line — pick the exact spell in the dropdown. The engine skips whatever the current job combo cannot cast. Presence is read live from your own buffs, so a dispelled or worn buff is recast immediately; the minutes are only a fallback (stock duration — raise it for gear/Composure builds)."
                   TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="2" Text="Accession (SCH main or sub): preps before the cast so the self-cast also lands on party members in range — no per-member range check. Perpetuance (SCH main): preps before the cast and extends the duration — only for spells an SCH main can cast (multiplier on the Scholar page). Bar-element, bar-status, enspell and storm buffs are mutually exclusive; the engine will not overwrite one with another. Only one Gain-*, one Boost-*, one enspell, one storm, one Protect row (single OR -ra), one Shell row (single OR -ra), one bar-element row (single OR -ra) and one bar-status row (single OR -ra) can be enabled at a time."
                   TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"/>

        <!-- Filter row: job dropdowns (prefilled from the attached character), text
             search over group/spell/notes, and an enabled-only toggle. View-only. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Filter:" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBlock Text="Main" VerticalAlignment="Center" Margin="10,0,2,0"/>
            <ComboBox x:Name="MainJobBox" Width="64" SelectionChanged="Filter_Changed"
                      ToolTip="Show only rows a spell in the row is castable by this main job"/>
            <TextBox x:Name="MainLevelBox" Width="34" Margin="2,0,0,0" TextChanged="Filter_Changed"
                     VerticalContentAlignment="Center" ToolTip="Main job level (JP-gated spells count as 99 main-only)"/>
            <TextBlock Text="Sub" VerticalAlignment="Center" Margin="10,0,2,0"/>
            <ComboBox x:Name="SubJobBox" Width="64" SelectionChanged="Filter_Changed"
                      ToolTip="Show only rows castable by this sub job at its level"/>
            <TextBox x:Name="SubLevelBox" Width="34" Margin="2,0,0,0" TextChanged="Filter_Changed"
                     VerticalContentAlignment="Center" ToolTip="Sub job level"/>
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="14,0,2,0"/>
            <TextBox x:Name="SearchBox" Width="110" TextChanged="Filter_Changed" VerticalContentAlignment="Center"
                     ToolTip="Matches group name, spell names, and notes (e.g. 'barf', 'storm', 'WHM 75')"/>
            <CheckBox x:Name="EnabledOnlyBox" Content="Enabled only" VerticalAlignment="Center" Margin="14,0,0,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"
                      ToolTip="Show only rows that are On in this profile (rows you toggle stay put until the next filter change)"/>
            <Button Content="Clear" Width="50" Margin="14,0,0,0" Click="ClearFilter_Click" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                <DataGridTextColumn Header="Buff" Binding="{Binding Group}" IsReadOnly="True" Width="120"/>
                <DataGridTemplateColumn Header="Spell" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Spells}"
                                      SelectedItem="{Binding SelectedSpell, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding HasChoices}"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Min" Binding="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" Width="46"/>
                <DataGridTemplateColumn Header="Accession" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding UseAccession, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding AccessionCompatible}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Perpetuance" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding UsePerpetuance, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding PerpetuanceCompatible}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Exclusivity" Binding="{Binding FamilyLabel}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>

<Window x:Class="CurePlease.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cure Please — Settings" Height="820" Width="1060"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Profile bar -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Profile:" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBlock x:Name="ProfileNameText" VerticalAlignment="Center" Margin="4,0,16,0"/>
            <TextBlock x:Name="ProfileHintText" VerticalAlignment="Center" Foreground="Gray"/>
            <Button Content="Save As…" Padding="8,0" Margin="12,0,0,0" VerticalAlignment="Center"
                    Click="SaveAs_Click" ToolTip="Save the current edits as a new profile and switch to it"/>
            <Button Content="Duplicate…" Padding="8,0" Margin="6,0,0,0" VerticalAlignment="Center"
                    Click="Duplicate_Click" ToolTip="Copy the active profile's saved file under a new name"/>
            <Button Content="Delete…" Padding="8,0" Margin="6,0,0,0" VerticalAlignment="Center"
                    Click="Delete_Click" ToolTip="Delete the active profile's file from disk"/>
        </StackPanel>

        <!-- Nav + page -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <CheckBox x:Name="ComboFilterBox" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                          ToolTip="Trim the job pages below to the profile's main/sub combo. Off by default — nothing is hidden unless you ask."
                          Checked="ComboFilterBox_Toggled" Unchecked="ComboFilterBox_Toggled"/>
                <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged"/>
            </DockPanel>
            <ContentControl x:Name="PageHost" Grid.Column="1"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,16,0"/>
            <Button Content="Save" Width="90" Margin="0,0,8,0" Click="Save_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="90" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

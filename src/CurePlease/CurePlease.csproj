<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <Version>3.0.0.0</Version>
  </PropertyGroup>

  <!-- FFXI.Memory is expected to be cloned alongside this repo (D:\Code\repos\FFXI.Memory) -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\FFXI.Memory\FFXI.Memory.csproj" AdditionalProperties="Configuration=$(Configuration)" />
  </ItemGroup>

</Project>
